<Project>
	<PropertyGroup>			 
		<Product>Fantaseer</Product>
		<Company>Foobasaur, Esquire</Company>
		<Description>High Falootin Technology</Description>
		<Copyright>Copyright © 2026</Copyright>
	</PropertyGroup>
	<PropertyGroup>
		<FileVersion>0.0.1.0</FileVersion>
		<AssemblyVersion>0.0.1.0</AssemblyVersion>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)' == 'Pre'">
		<DefineConstants>$(DefineConstants);Pre</DefineConstants>
	</PropertyGroup>
	<!-- RELEASE is not auto-defined by the SDK; Server.HREF keys off it to target the live API. -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<DefineConstants>$(DefineConstants);RELEASE</DefineConstants>
	</PropertyGroup>
</Project>