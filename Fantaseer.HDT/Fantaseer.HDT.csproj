<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<AssemblyTitle>Fantaseer.HDT</AssemblyTitle>
		<TargetFramework>net472</TargetFramework>
		<LangVersion>Latest</LangVersion>
		<Nullable>enable</Nullable>
		<UseWPF>true</UseWPF>
		<ImplicitUsings>enable</ImplicitUsings>
		<OutputType>Library</OutputType>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<ComVisible>false</ComVisible>
		<Platforms>x86</Platforms>							
		<Guid>ee465e91-527c-11f1-919e-c2b62456cdd1</Guid>
		<Configurations>Debug;Release;Plugin</Configurations>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)' == 'Plugin'">
		<OutputPath>C:\Users\ezexey\AppData\Roaming\HearthstoneDeckTracker\Plugins</OutputPath>
	</PropertyGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.InteropServices.GuidAttribute">
			<_Parameter1>$(Guid)</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Fantaseer\Fantaseer.csproj" />
	</ItemGroup>

	<!-- HDT references: local dev builds against the HDT source checkout; CI sets HdtDir to a directory
	     containing an extracted HDT release and builds against those assemblies instead. -->
	<ItemGroup Condition="'$(HdtDir)' == ''">
		<ProjectReference Include="E:\source\Hearthstone-Deck-Tracker\Hearthstone Deck Tracker\Hearthstone Deck Tracker.csproj">
			<Private>False</Private>
			<CopyLocalSatelliteAssemblies>False</CopyLocalSatelliteAssemblies>
			<ExcludeAssets>runtime</ExcludeAssets>
		</ProjectReference>
		<ProjectReference Include="E:\source\Hearthstone-Deck-Tracker\HearthWatcher\HearthWatcher.csproj">
			<Private>False</Private>
			<ExcludeAssets>runtime</ExcludeAssets>
		</ProjectReference>
		<Reference Include="HearthDb">
			<HintPath>E:\source\Hearthstone-Deck-Tracker\lib\HearthDb.dll</HintPath>
			<Private>False</Private>
			<CopyLocalSatelliteAssemblies>False</CopyLocalSatelliteAssemblies>
			<ExcludeAssets>runtime</ExcludeAssets>
		</Reference>
	</ItemGroup>
	<ItemGroup Condition="'$(HdtDir)' != ''">
		<Reference Include="HearthstoneDeckTracker">
			<HintPath>$(HdtDir)\HearthstoneDeckTracker.exe</HintPath>
			<Private>False</Private>
			<CopyLocalSatelliteAssemblies>False</CopyLocalSatelliteAssemblies>
		</Reference>
		<Reference Include="HearthWatcher">
			<HintPath>$(HdtDir)\HearthWatcher.dll</HintPath>
			<Private>False</Private>
			<CopyLocalSatelliteAssemblies>False</CopyLocalSatelliteAssemblies>
		</Reference>
		<Reference Include="HearthDb">
			<HintPath>$(HdtDir)\HearthDb.dll</HintPath>
			<Private>False</Private>
			<CopyLocalSatelliteAssemblies>False</CopyLocalSatelliteAssemblies>
		</Reference>
		<!-- Transitive deps of the HDT ProjectReference that the plugin uses directly; HDT ships all of
		     these, so they must not be copied to output either. -->
		<Reference Include="MahApps.Metro">
			<HintPath>$(HdtDir)\MahApps.Metro.dll</HintPath>
			<Private>False</Private>
			<CopyLocalSatelliteAssemblies>False</CopyLocalSatelliteAssemblies>
		</Reference>
		<Reference Include="WPFLocalizeExtension">
			<HintPath>$(HdtDir)\WPFLocalizeExtension.dll</HintPath>
			<Private>False</Private>
			<CopyLocalSatelliteAssemblies>False</CopyLocalSatelliteAssemblies>
		</Reference>
		<Reference Include="XAMLMarkupExtensions">
			<HintPath>$(HdtDir)\XAMLMarkupExtensions.dll</HintPath>
			<Private>False</Private>
			<CopyLocalSatelliteAssemblies>False</CopyLocalSatelliteAssemblies>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Properties\Stringz.Designer.cs">
			<DependentUpon>Stringz.resx</DependentUpon>
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
		</Compile>
	</ItemGroup>
	<ItemGroup>
		<EmbeddedResource Update="Properties\Stringz.resx">
			<LastGenOutput>Stringz.Designer.cs</LastGenOutput>
			<Generator>ResXFileCodeGenerator</Generator>
		</EmbeddedResource>
	</ItemGroup>
</Project>
